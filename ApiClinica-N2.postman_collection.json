  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Gera CPF valido e datas futuras a cada execucao da colecao",
          "function fmt(x) {",
          "  const p = (n) => String(n).padStart(2, '0');",
          "  return x.getFullYear() + '-' + p(x.getMonth()+1) + '-' + p(x.getDate())",
          "       + 'T' + p(x.getHours()) + ':' + p(x.getMinutes()) + ':00';",
          "}",
          "",
          "if (!pm.collectionVariables.get('dataHora')) {",
          "  const d = new Date();",
          "  d.setDate(d.getDate() + 14);",
          "  d.setHours(10, 0, 0, 0);",
          "  pm.collectionVariables.set('dataHora', fmt(d));",
          "",
          "  const d15 = new Date(d); d15.setMinutes(d15.getMinutes() + 15);",
          "  pm.collectionVariables.set('dataHora15', fmt(d15));",
          "",
          "  const d30 = new Date(d); d30.setMinutes(d30.getMinutes() + 30);",
          "  pm.collectionVariables.set('dataHora30', fmt(d30));",
          "",
          "  const dp = new Date(); dp.setDate(dp.getDate() - 7);",
          "  pm.collectionVariables.set('dataPassada', fmt(dp));",
          "}",
          "",
          "if (!pm.collectionVariables.get('cpf')) {",
          "  const n = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
          "  const dig = (arr) => {",
          "    let soma = 0, peso = arr.length + 1;",
          "    for (const x of arr) soma += x * peso--;",
          "    const r = soma % 11;",
          "    return r < 2 ? 0 : 11 - r;",
          "  };",
          "  const d1 = dig(n);",
          "  const d2 = dig([...n, d1]);",
          "  pm.collectionVariables.set('cpf', [...n, d1, d2].join(''));",
          "}"
        ]
      }
    }
  ],
